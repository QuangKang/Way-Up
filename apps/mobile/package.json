{
  "name": "@climb/mobile",
  "version": "1.0.0",
  "description": "4-player real-time vertical climbing mobile game client using Expo SDK and TypeScript",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@climb/shared": "*",
    "expo": "~58.0.0",
    "expo-crypto": "~58.0.8",
    "expo-haptics": "~58.0.8",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
